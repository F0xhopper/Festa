{
	"name": "festa",
	"version": "1.0.0",
	"description": "Traditional Roman calendar (1962) feasts in Obsidian daily notes",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"lint": "eslint .",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"data:generate": "uv run --project scripts python scripts/generate.py --years 2020-2040",
		"data:verify": "uv run --project scripts python scripts/verify.py"
	},
	"keywords": ["obsidian", "catholic", "liturgical-calendar", "1962", "traditional-latin-mass"],
	"author": "Eden Fox Phillips",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^3.2.4"
	},
	"dependencies": {
		"obsidian-daily-notes-interface": "^0.9.5"
	}
}
